# .env.example
# Core Profile Setup Placeholders
SECRET_KEY=xxxxxxx(django-insecure-placeholder-key-for-github-documentation)
DEBUG=True
DB_NAME=xxxxxxx
DB_USER=xxxxxxx
DB_PASSWORD=xxxxxxx
DB_HOST=localhost
DB_PORT=5432
CORS_ALLOWED_ORIGINS=http://localhost:5173
ALLOWED_HOSTS=127.0.0.1,localhost

# Semantic Configuration Parameters
CUBE_API_SECRET=xxxxxxx(placeholder_secret_key_for_cube_api)
CUBE_API_URL=http://localhost:4000/v1/load
CUBEJS_DB_HOST=xxxxxxx
CUBEJS_CUBESTORE_HOST=xxxxxxx
CUBEJS_CUBESTORE_PORT=xxxxxxx

# Ollama Configuration Parameters
OLLAMA_API_URL=http://localhost:11434/api/generate

# Cascading Infrastructure Deployment Targets
GEMINI_API_KEY=xxxxxxx(placeholder_insert_your_google_gemini_api_key_here)
REMOTE_GPU_USER=xxxxxxx
REMOTE_GPU_SERVER_IP=xxxxxxx(placeholder_insert_your_secure_vpn_server_ip_here)
LOCAL_FORWARD_PORT=xxxxxxx
REMOTE_LLM_PORT=xxxxxxx